---
import PostListLayout from '../layouts/PostListLayout.astro';
import { SITE_TITLE } from '../config';
import { getPosts, paginate } from '../lib/posts';

const { posts, totalPages, currentPage } = paginate(await getPosts(), 1);
---

<PostListLayout title={SITE_TITLE} posts={posts} totalPages={totalPages} currentPage={currentPage} />
