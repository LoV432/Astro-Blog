---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../config';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main class="mt-10 place-self-center">
		<h1 role="img" aria-label="Page not found" class="neonText mb-28 text-9xl font-extrabold"><a class="pl-[0.2em] tracking-[0.2em]" href="/">404</a></h1>
	</main>
</BaseLayout>
