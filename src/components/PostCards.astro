---
import PostImage from '../components/PostImage.astro';
import imageHelper from '../lib/image-helper';
import type { Post } from '../lib/posts';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
const originalImages = await Promise.all(posts.map((post) => imageHelper(post.data.cover, 'original')));
---

<section class="grid place-items-center">
	{
		posts.map((post, i) => (
			<>
				<a aria-disabled="true" role="link" aria-label="prefetch image" data-astro-prefetch="viewport" tabindex="-1" href={originalImages[i].src} />
				<div
					class="relative mb-6 grid w-[20rem] overflow-hidden rounded-lg border-2 border-rose-700 shadow-xl shadow-rose-600/10 transition-all hover:-translate-y-1
				hover:shadow-rose-600/40 sm:grid-rows-[1fr_66%] md:min-h-[184px] md:w-[48rem] md:grid-cols-[1fr_63%] md:grid-rows-none"
				>
					<PostImage imageObject={post.data.cover} classes={'rounded-l-xs w-full h-full aspect-video object-cover flex place-items-center justify-center'} size={'small'} alt={'Thumbnail'} />
					<div class="h-fit rounded-r-xs bg-zinc-900 md:h-full">
						<div class="m-5 mb-3">
							<a tabindex="0" href={`/blog/${post.id}/`} data-astro-prefetch="viewport" class="z-10 text-3xl after:absolute after:bottom-0 after:left-0 after:right-0 after:top-0">
								{post.data.heading}
							</a>
						</div>
						<div class="relative mx-5 mb-5 w-fit">
							<span class="mr-2 rounded-sm bg-rose-200 px-2.5 py-0.5 pb-1 text-xs font-semibold text-rose-900">tags:</span>
							{post.data.tags.map((tag) => (
								<a class="z-20 inline-block text-blue-500 hover:text-rose-700" href={`/tag/${tag}/`} data-astro-prefetch="viewport">
									#{tag} &VeryThinSpace;
								</a>
							))}
						</div>
						<div class="pb-5 pl-5 pr-5">
							<p class="line-clamp-5 overflow-hidden md:line-clamp-3">{post.data.description}</p>
						</div>
					</div>
				</div>
			</>
		))
	}
</section>
